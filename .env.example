BOT_TOKEN=123456789:AAGASD2cxfatkDasDE22dqfawdfawd2WD-UI
BOT_DEV_ID=123456789
BOT_GROUP_ID=-100123456789
# Кастомный emoji для новых топиков; пусто = без иконки (если нет Premium у аккаунта бота)
BOT_EMOJI_ID=5417915203100613993
# Юзернейм основного бота без @ (deep link из /information: t.me/BOT?start=user_<id>)
BOT_USERNAME=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Groq (https://console.groq.com) — пустой ключ = ИИ отключён
# Без кавычек: GROQ_API_KEY=gsk_...  |  при 403: новый ключ, проверить env в контейнере
GROQ_API_KEY=
# false — не вызывать ИИ (история для контекста не пишется)
GROQ_ENABLED=true
# Текстовые ответы. llama-3.3-70b-versatile снимается 16.08.2026; замена — gpt-oss-120b или qwen3.6-27b
# Для одной модели на текст+vision: GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b
# После ответа оператора в топике ИИ не отвечает в ЛС N секунд (не ниже 3600 = 1 ч); по истечении — снова может отвечать в том же топике
GROQ_OPERATOR_LOCK_SEC=3600
# Антиспам: не более ANTISPAM_MAX_MESSAGES сообщений за ANTISPAM_WINDOW_SEC секунд
# При превышении — предупреждение с автоудалением через 5 сек, сообщение игнорируется
ANTISPAM_MAX_MESSAGES=5
ANTISPAM_WINDOW_SEC=30
# Cooldown ИИ: минимальный интервал (сек) между ответами Groq одному пользователю (0 = выкл.)
ANTISPAM_GROQ_COOLDOWN_SEC=10

# Vision: фото + подпись → ИИ анализирует изображение; только фото без подписи — пропуск
# meta-llama/llama-4-scout-17b снята 17.07.2026; gpt-oss-120b vision не поддерживает
GROQ_VISION_ENABLED=true
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# HTTP API для чата поддержки из веб-ЛК (без изменений SoloBot API)
WEB_API_ENABLED=true
# Внутри контейнера слушать на всех интерфейсах (не 127.0.0.1 — иначе проброс ports не сработает)
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8080
# Origin ЛК для CORS (через запятую). Prod: https://cp.example.com ; dev: http://localhost:5174
WEB_CORS_ORIGINS=http://localhost:5174,https://cp.example.com
# Публичный URL ЛК/API для проверки cookie-сессии (GET /api/auth/me)
CABINET_API_URL=https://cp.example.com
